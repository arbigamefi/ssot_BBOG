# Example production web environment for Base mainnet casino launch
#
# This file is a template, not a deploy approval. Copy it outside docs, fill every
# placeholder from the approved deployment packet, then run:
#   ENV_FILE=.env.web-production make casino-web-env-check-v13
#   REQUIRE_SOURCEMAPS=1 ENV_FILE=.env.web-production make casino-web-env-check-v13
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle. Never
# put private RPC credentials, private keys, or signing keys in NEXT_PUBLIC_ values.

NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_ENV=production

# Browser RPC. Use a public browser-safe Base mainnet endpoint. If using Alchemy,
# prefer NEXT_PUBLIC_ALCHEMY_API_KEY over embedding a full private endpoint.
NEXT_PUBLIC_BASE_RPC_URL=
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_ALCHEMY_API_KEY=

# WalletConnect Cloud project ID.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public feature flags.
# Sportsbook stays closed until the approved sportsbook frontend-access memo passes.
NEXT_PUBLIC_SPORTSBOOK_ENABLED=false

# Casino risk-in stays closed until the approved casino frontend-access memo passes.
NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=false

# Sentry runtime error tracking. Release should be the deploy commit SHA or signed release tag.
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload secrets are CI/deploy-only. Do not expose these to the browser.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Public read API limits. Keep defaults conservative for launch, then tune from traffic data.
BETS_RECENT_RATE_LIMIT_PER_MINUTE=120
BETS_PLAYER_RATE_LIMIT_PER_MINUTE=120
BETS_AFFILIATE_RATE_LIMIT_PER_MINUTE=120
SPORTSBOOK_PLAYER_TICKETS_RATE_LIMIT_PER_MINUTE=120
HEALTHZ_RATE_LIMIT_PER_MINUTE=120
