# Example environment for Base mainnet v1.3 Casino+Sports readiness
#
# This file is a template, not a deploy approval. Copy it outside docs, fill every
# placeholder from approved custody/risk memos, then run:
#   ENV_FILE=.env.base-mainnet-v13 make sports-mainnet-preflight-v13
#
# The preflight proves env shape, chain id, role placeholders, ERC20 bytecode, and
# VRF wrapper bytecode. It does not authorize a broadcast.

RPC_URL=
PRIVATE_KEY=
GOV=

# Optional treasury override. Leave empty to use GOV as treasury in DeployV13.
# TREASURY=

# Chainlink VRF v2.5 Wrapper (Base mainnet).
# Source: https://docs.chain.link/vrf/v2-5/supported-networks
# Re-check against the official Chainlink supported-networks table before broadcast.
VRF_WRAPPER=0xb0407dbe851f8318bd31404A49e658143C982F23

# Conservative fee-estimator gas price for Chainlink VRF wrapper requests.
# Refresh from current Base gas conditions before broadcast. DeployV13 rejects 0
# on public networks.
REQUEST_GAS_PRICE_WEI=10000000

# Base mainnet USDC.
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
# Re-check against Circle's official address table before broadcast.
BASE_MAINNET_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

NUM_POOLS=2

POOL_ID_0=1
POOL_DOMAIN_0=1
POOL_ASSET_0=$BASE_MAINNET_USDC
LP_NAME_0="LP USDC Casino"
LP_SYMBOL_0="lpUSDC-C"
LP_DECIMALS_0=6
BANK_MIN_LIQ_BPS_0=1000
# Raw asset units, rescaled per pool decimals: 20 units is 20000000 on
# 6-decimal USDC. The 18-decimal literal makes the threshold unreachable and
# permanently locks referral XP.
BANK_MIN_TURNOVER_FOR_UNLOCK_0=20000000
BANK_HOLDBACK_VESTING_SECONDS_0=86400

POOL_ID_1=2
POOL_DOMAIN_1=2
POOL_ASSET_1=$BASE_MAINNET_USDC
LP_NAME_1="LP USDC Sports"
LP_SYMBOL_1="lpUSDC-S"
LP_DECIMALS_1=6
BANK_MIN_LIQ_BPS_1=1000
# 20 USDC, 6 decimals (see pool 0).
BANK_MIN_TURNOVER_FOR_UNLOCK_1=20000000
BANK_HOLDBACK_VESTING_SECONDS_1=86400

# Global casino/referral policy. These defaults match DeployV13 defaults and are
# repeated here so mainnet reviewers make an explicit decision.
REFUND_TIMEOUT_SECONDS=3600
DEFAULT_HOUSE_EDGE_BPS=200
MAX_AFFILIATE_DELTA_BPS=0
REF_BASE_BUDGET_BPS=10000
REF_DELTA_BUDGET_BPS=10000
REF_HOLDBACK_BPS=3000
REF_LEVELS=2
REF_LEVEL0_BPS=0
REF_LEVEL1_BPS=10000
REF_LEVEL2_BPS=0
REF_LEVEL3_BPS=0
REF_LEVEL4_BPS=0
REF_LEVEL5_BPS=0

# Raw USDC units. Do not copy testnet caps. These must come from the approved
# sportsbook bankroll memo before any SportsHub risk-in or public sportsbook UI.
SPORTS_MAX_STAKE=
SPORTS_MAX_PAYOUT=
SPORTS_MAX_MARKET_RESERVED=
SPORTS_MAX_OUTCOME_RESERVED=
SPORTS_MAX_EVENT_RESERVED=

# Required role-set policy. Use approved hashes/addresses only.
# If SPORTS_DERIVE_ROLE_SET_HASHES=true, DeployV13 derives final hashes from the
# deployed SportsHub address and the bootstrap roles below.
SPORTS_ODDS_SIGNER_SET_HASH=
SPORTS_RESULT_REPORTER_SET_HASH=
SPORTS_RESULT_REPORTER_THRESHOLD=1
SPORTS_RESULT_CHALLENGE_TIMEOUT_SECONDS=604800
SPORTS_DERIVE_ROLE_SET_HASHES=false
SPORTS_ODDS_SIGNER=
SPORTS_RESULT_REPORTER=
SPORTS_RESULT_CHALLENGER=
SPORTS_RESULT_ARBITRATOR=
