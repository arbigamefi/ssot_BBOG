# Example environment for Base mainnet v1.4 casino-only deployment
#
# This file is a template, not a deploy approval. Copy it outside docs, fill every
# placeholder from approved custody/risk memos, then run a no-broadcast dry run
# before any mainnet broadcast:
#
#   cp docs/deploy/base-mainnet-v14-casino.env.example .base-mainnet-v14-casino.env
#   # edit .base-mainnet-v14-casino.env
#   set -a; source .base-mainnet-v14-casino.env; set +a
#   FOUNDRY_PROFILE=default forge script script/DeployV14.s.sol:DeployV14 --rpc-url "$RPC_URL" -vvv
#
# Broadcast only after the dry run is clean:
#
#   set -a; source .base-mainnet-v14-casino.env; set +a
#   make deploy-v14
#
# V14 is the pre-launch casino release that adds standard Bank provider events
# and on-chain Bank performance counters. It supersedes the older v13 mainnet
# casino release for public launch.

RPC_URL=
PRIVATE_KEY=
GOV=

# Optional treasury override. Leave empty to use GOV as treasury in DeployV14.
# TREASURY=

# Chainlink VRF v2.5 Wrapper (Base mainnet).
# Re-check against Chainlink's official supported-networks table before broadcast.
VRF_WRAPPER=0xb0407dbe851f8318bd31404A49e658143C982F23

# Conservative fee-estimator gas price for Chainlink VRF wrapper requests.
# DeployV14 rejects 0 on public networks.
REQUEST_GAS_PRICE_WEI=10000000

# Base mainnet assets.
# Re-check USDC against Circle's official address table before broadcast.
BASE_MAINNET_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_MAINNET_WETH=0x4200000000000000000000000000000000000006

NUM_POOLS=2

POOL_ID_0=1
POOL_DOMAIN_0=1
POOL_ASSET_0=$BASE_MAINNET_USDC
LP_NAME_0="LP USDC Casino"
LP_SYMBOL_0="lpUSDC-C"
LP_DECIMALS_0=6
BANK_MIN_LIQ_BPS_0=1000
BANK_WITHDRAWAL_BUFFER_BPS_0=1000
BANK_MIN_TURNOVER_FOR_UNLOCK_0=20000000000000000000
BANK_HOLDBACK_VESTING_SECONDS_0=86400

POOL_ID_1=3
POOL_DOMAIN_1=1
POOL_ASSET_1=$BASE_MAINNET_WETH
LP_NAME_1="LP WETH Casino"
LP_SYMBOL_1="lpWETH-C"
LP_DECIMALS_1=18
BANK_MIN_LIQ_BPS_1=1000
BANK_WITHDRAWAL_BUFFER_BPS_1=1000
BANK_MIN_TURNOVER_FOR_UNLOCK_1=20000000000000000000
BANK_HOLDBACK_VESTING_SECONDS_1=86400

# Global casino/referral policy. Keep these explicit so mainnet reviewers make
# an intentional decision instead of relying on DeployV14 defaults.
REFUND_TIMEOUT_SECONDS=3600
DEFAULT_HOUSE_EDGE_BPS=200
MAX_AFFILIATE_DELTA_BPS=0
REF_BASE_BUDGET_BPS=10000
REF_DELTA_BUDGET_BPS=10000
REF_HOLDBACK_BPS=3000
REF_LEVELS=2
REF_LEVEL0_BPS=0
REF_LEVEL1_BPS=10000
REF_LEVEL2_BPS=0
REF_LEVEL3_BPS=0
REF_LEVEL4_BPS=0
REF_LEVEL5_BPS=0
