# Public v1.6 parameters for Base Sepolia. No keys or RPC credentials. Source with set -a.
# Refresh Safe controls and review gas/bank parameters before broadcast.
# Fill every placeholder from the intended fresh deployment and verify the external contracts on this chain.
CHAIN_ID=84532
DEPLOYER=REPLACE_DEPLOYER
GOV=REPLACE_GOV
GUARDIAN=REPLACE_GUARDIAN
RELEASE_SIGNER=REPLACE_RELEASE_SIGNER
KEEPER_ADDRESS=REPLACE_KEEPER_ADDRESS
SAFE_CODE_HASH=REPLACE_SAFE_CODE_HASH
SAFE_OWNERS_HASH=REPLACE_SAFE_OWNERS_HASH
SAFE_CONTROL_HASH=REPLACE_SAFE_CONTROL_HASH
VRF_WRAPPER=REPLACE_VRF_WRAPPER
NUM_POOLS=1
# Range 60..86400 seconds; the accepted default is one hour.
# Each accepted bet snapshots its deadline; changes affect new bets only.
REFUND_TIMEOUT_SECONDS=3600
# House-edge allocation. LPs keep half of each bet's edge; the referral rates below are
# bps of the base-edge portion and together at most 3500. The affiliate markup cap starts
# at 0 and can only be raised later through the 7-day delay.
DEFAULT_HOUSE_EDGE_BPS=200
REF_L0_BPS=1000
REF_L1_BPS=2000
REF_L2_BPS=500
REF_HOLDBACK_BPS=3000
POOL_ASSET_0=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BANK_MIN_STAKE_0=1000000
POOL_ID_0=1
POOL_DOMAIN_0=1
LP_DECIMALS_0=6
BANK_MIN_TURNOVER_FOR_UNLOCK_0=20000000
BANK_HOLDBACK_VESTING_SECONDS_0=86400
