# Public v1.6 parameters for Base Sepolia. No keys or RPC credentials. Source with set -a.
# Refresh Safe controls and review gas/bank parameters before broadcast.
# Fill every placeholder from the intended fresh deployment and verify the external contracts on this chain.
CHAIN_ID=84532
DEPLOYER=REPLACE_DEPLOYER
GOV=REPLACE_GOV
GUARDIAN=REPLACE_GUARDIAN
RELEASE_SIGNER=REPLACE_RELEASE_SIGNER
KEEPER_ADDRESS=REPLACE_KEEPER_ADDRESS
SAFE_CODE_HASH=REPLACE_SAFE_CODE_HASH
SAFE_OWNERS_HASH=REPLACE_SAFE_OWNERS_HASH
SAFE_CONTROL_HASH=REPLACE_SAFE_CONTROL_HASH
VRF_WRAPPER=REPLACE_VRF_WRAPPER
# Hard maximum: 25 rounds. Each game may use a lower qualified count.
# Callback gas still requires full-path qualification; sampled successes are not a universal bound.
GAME_MAX_BET_COUNT_DICE=25
GAME_CALLBACK_GAS_LIMIT_DICE=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_COIN_TOSS=25
GAME_CALLBACK_GAS_LIMIT_COIN_TOSS=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_ROULETTE=25
GAME_CALLBACK_GAS_LIMIT_ROULETTE=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_KENO=25
GAME_CALLBACK_GAS_LIMIT_KENO=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_PLINKO=25
GAME_CALLBACK_GAS_LIMIT_PLINKO=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_SIC_BO=25
GAME_CALLBACK_GAS_LIMIT_SIC_BO=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_SLOTS=25
GAME_CALLBACK_GAS_LIMIT_SLOTS=REPLACE_QUALIFIED_GAS
GAME_MAX_BET_COUNT_BACCARAT=25
GAME_CALLBACK_GAS_LIMIT_BACCARAT=REPLACE_QUALIFIED_GAS
NUM_POOLS=1
# Range 60..86400 seconds; the accepted default is one hour.
# Each accepted bet snapshots its deadline; changes affect new bets only.
REFUND_TIMEOUT_SECONDS=3600
# House-edge allocation. LPs keep half of each bet's edge; the L0/L1/L2 rates below
# are bps of that same edge and together at most 3500. House-edge changes require
# the 7-day delay; referral bindings never alter the accepted price.
DEFAULT_HOUSE_EDGE_BPS=200
REF_L0_BPS=1000
REF_L1_BPS=2000
REF_L2_BPS=500
REF_HOLDBACK_BPS=3000
POOL_ASSET_0=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Minimum per round: 0.01 USDC (6 decimals); 25 rounds require 0.25 USDC total.
BANK_MIN_BET_AMOUNT_0=10000
# New bets retain 60% of G after stake receipt; existing reserves count against the remainder.
BANK_RISK_RESERVE_BPS_0=6000
# Independent PF/XP collection buffer. This is not an LP NFT withdrawal limit.
BANK_WITHDRAWAL_BUFFER_BPS_0=1000
POOL_ID_0=1
POOL_DOMAIN_0=1
# Asset decimals are read from the token; NFTs have no monetary share precision.
BANK_MIN_TURNOVER_FOR_UNLOCK_0=20000000
BANK_HOLDBACK_VESTING_SECONDS_0=86400
