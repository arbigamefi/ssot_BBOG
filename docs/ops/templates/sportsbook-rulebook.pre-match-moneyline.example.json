{
  "schemaVersion": "sportsbook.rulebook.v1",
  "scope": "pre-match-fixed-odds-single",
  "sport": "soccer",
  "league": "example-league",
  "eventId": "provider:event:example-2026-05-14-home-away",
  "marketType": "moneyline",
  "marketKey": "example-league:2026-05-14:home-away:moneyline",
  "outcomes": [
    {
      "outcomeId": 1,
      "label": "home"
    },
    {
      "outcomeId": 2,
      "label": "draw"
    },
    {
      "outcomeId": 3,
      "label": "away"
    }
  ],
  "lockPolicy": {
    "locksAt": "scheduled-start-minus-0s",
