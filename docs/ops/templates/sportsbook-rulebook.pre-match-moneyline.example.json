    "abandonedWithoutOfficialResult": true,
    "providerDisagreementHandling": "escalate-to-arbitration"
  },
  "providers": {
    "primary": "provider-to-be-approved",
    "secondary": "provider-to-be-approved",
    "officialFallback": "official-league-source-to-be-approved"
  },
  "approvals": {
