# ──────────────────────────────────────────────
# SSOT Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser bundle. Never put secrets here.
# ──────────────────────────────────────────────

# WalletConnect Cloud project ID (optional)
# Get one free at https://cloud.walletconnect.com
# Falls back to demo ID if not set.
NEXT_PUBLIC_WC_PROJECT_ID=

# Sentry error tracking (optional)
# Leave blank to disable error tracking.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for source map upload (CI only, not NEXT_PUBLIC_)
# SENTRY_AUTH_TOKEN=

# Analytics (optional, future use)
# NEXT_PUBLIC_ANALYTICS_ID=
