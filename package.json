{
  "name": "bankroll-protocol-ssot",
  "private": true,
  "version": "0.1.0",
  "description": "Unified repo entrypoint for the SSOT contracts and frontend workspaces.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "20.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "setup": "make deps && pnpm -C frontend install",
    "contracts:deps": "make deps",
    "contracts:build": "forge build",
    "contracts:test": "make test",
    "contracts:lint": "make lint",
    "contracts:release-check": "make release-check",
    "frontend:install": "pnpm -C frontend install",
    "frontend:dev": "pnpm -C frontend dev",
    "frontend:build": "pnpm -C frontend build",
    "frontend:lint": "pnpm -C frontend lint",
    "frontend:typecheck": "pnpm -C frontend typecheck",
    "frontend:test": "pnpm -C frontend test",
    "frontend:test:strict": "pnpm -C frontend test:strict",
    "frontend:storybook": "pnpm -C frontend storybook",
    "frontend:storybook:build": "pnpm -C frontend storybook:build",
    "frontend:release-check": "pnpm -C frontend check:release",
    "check": "make test && pnpm -C frontend lint && pnpm -C frontend typecheck && pnpm -C frontend test:strict && pnpm -C frontend build"
  }
}
