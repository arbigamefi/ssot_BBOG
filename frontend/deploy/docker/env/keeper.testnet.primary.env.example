KEEPER_RPC_HTTP=https://sepolia.base.org
KEEPER_RPC_WS=
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_PRIMARY_KEEPER_PRIVATE_KEY

KEEPER_ROLE=primary
