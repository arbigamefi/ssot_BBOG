# Copy to deploy/docker/env/keeper.testnet.primary.env.
# Never commit a real keeper private key.

KEEPER_CHAIN_ID=84532
KEEPER_RELEASE_PATH=/app/frontend/packages/ssot/src/release/embedded/chain-84532.json
# Empty uses the selected signed release block; never copy a retired deployment cursor.
KEEPER_START_BLOCK=
# HTTP scanning runs on Infura's free tier: 3M credits a day (reset daily) and
# 500 a second; eth_getLogs costs 255 and eth_blockNumber 80. WebSocket runs on
# Alchemy, which bills subscriptions by bandwidth, not per call.
KEEPER_RPC_HTTP=https://base-sepolia.infura.io/v3/REPLACE_WITH_INFURA_API_KEY
KEEPER_RPC_WS=wss://base-sepolia.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_API_KEY
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_PRIMARY_KEEPER_PRIVATE_KEY

KEEPER_ROLE=primary
KEEPER_BACKUP_DELAY_SECONDS=0
# Without WebSocket events this is the longest wait from VRF callback to
# settlement. Each poll costs one eth_blockNumber and one eth_getLogs, and each
# ledger interval the same: 1,440 x 335 + 288 x 335 = ~0.58M credits a day per
# keeper, ~1.16M for the mainnet and testnet keepers on one Infura key.
KEEPER_POLL_INTERVAL_SECONDS=60
# Serializes this keeper's RPC calls. At 1200 ms, two keepers sharing an Infura
# key stay under its 500 credits a second even if every call is eth_getLogs.
KEEPER_RPC_MIN_INTERVAL_MS=1200
# Match the KEEPER_RPC_HTTP provider's eth_getLogs range limit: Infura accepted
# 10,000 blocks in testing, Alchemy's free tier allows 10, and the public
# Base Sepolia endpoint 1,000.
KEEPER_SCAN_CHUNK_BLOCKS=1000
# Bounds one catch-up pass. Unbounded, a cursor months behind becomes one
# provider request per chunk and scanner with no ceiling. A gamehub chunk is one
# eth_getLogs for all four GameHub events; a bank-ledger chunk is one for
# Deposit and Withdraw across all pools.
# Sustained casino.keeper.scan_capped requires bounded catch-up and gap review.
# Never fast-forward: this cursor also recovers unsettled BetRandomReady events.
KEEPER_SCAN_MAX_CHUNKS_PER_PASS=50
KEEPER_STARTUP_SCAN_ENABLED=false
KEEPER_SCAN_INDEX_EVENTS_ENABLED=true
KEEPER_BANK_PROVIDER_LEDGER_SCAN_INTERVAL_SECONDS=300

KEEPER_SPORTS_TICKET_INDEX_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_SCAN_CHUNK_BLOCKS=10
KEEPER_SPORTS_TERMINALIZER_MARKET_IDS=
KEEPER_SPORTS_TERMINALIZER_MAX_TICKETS_PER_MARKET=200
KEEPER_SPORTS_TICKET_SCAN_CHUNK_BLOCKS=10
# Sports recovery requires BET_INDEX_WRITE_ENABLED and a reachable database.
# This caps blocks per durable ticket-history pass, also bounded by max chunks.
# Progress resumes after restarts; never move the start beyond the deployment
# to skip a backlog. Each completed market drains all ticket pages.
KEEPER_SPORTS_TICKET_SCAN_MAX_BLOCKS=50000
KEEPER_SPORTS_TICKET_SCAN_START_BLOCK=

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi
BET_INDEX_SSL=false

# Casino lifecycle recovery defaults to the release block, independently of KEEPER_START_BLOCK.
# Set an earlier original GameHub deployment block if this release reuses that Hub.
# Must never be later than the release block. Empty keeps the release origin.
KEEPER_CASINO_RECOVERY_START_BLOCK=
