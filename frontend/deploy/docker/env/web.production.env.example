# Copy to deploy/docker/env/web.production.env.
# Public NEXT_PUBLIC_* values are embedded in the browser bundle.
# Do not put private keys in this file.

NEXT_PUBLIC_SITE_URL=https://arbigamefi.com
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_WC_PROJECT_ID=REPLACE_WITH_WALLETCONNECT_PROJECT_ID

# Use either a browser-safe Alchemy key or explicit public RPC URLs.
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=https://cloudflare-eth.com
NEXT_PUBLIC_RPC_URL=

# Server-only RPC. Keep this private if it contains a paid provider key.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
RPC_URL=

# Launch posture.
NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=false
NEXT_PUBLIC_SPORTSBOOK_ENABLED=false

# Durable bet-index read path. Keep this aligned with postgres.env.
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi
BET_INDEX_READ_ENABLED=true
BET_INDEX_RPC_FALLBACK_ENABLED=false
BET_INDEX_SSL=false

# Health checks.
HEALTHZ_REQUIRE_DURABLE_BET_INDEX=true
HEALTHZ_KEEPER_MAX_AGE_MS=300000

# Sentry / source-map release metadata.
NEXT_PUBLIC_SENTRY_RELEASE=base-mainnet-docker-v1
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Analytics and search verification are optional.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
