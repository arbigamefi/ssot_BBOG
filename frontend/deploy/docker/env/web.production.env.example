# Copy to deploy/docker/env/web.production.env.
# Public NEXT_PUBLIC_* values are embedded in the browser bundle.
# Do not put private keys in this file.

NEXT_PUBLIC_SITE_URL=https://arbigamefi.com
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_WC_PROJECT_ID=REPLACE_WITH_WALLETCONNECT_PROJECT_ID

# Browser RPC. The browser uses the NEXT_PUBLIC_* values baked into the image at CI build time
# (.github/workflows/frontend-docker-images.yml), and the Content-Security-Policy is built from them
# at the same time. At runtime these values only serve as the server's RPC fallback, so keep them
# identical to the build. Base's public RPCs rate-limit per visitor IP and need no key. Leave the
# Alchemy key empty: every NEXT_PUBLIC_* value is public.
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=https://cloudflare-eth.com
NEXT_PUBLIC_BASE_WS_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_WS_RPC_URL=
NEXT_PUBLIC_ARBITRUM_WS_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_WS_RPC_URL=
NEXT_PUBLIC_MAINNET_WS_RPC_URL=
NEXT_PUBLIC_RPC_URL=

# Server-only RPC. Keep this private if it contains a paid provider key.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
RPC_URL=

# Launch posture.
NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=false
NEXT_PUBLIC_LP_DEPOSITS_ENABLED=false
NEXT_PUBLIC_SPORTSBOOK_ENABLED=false

# Durable bet-index read path. Keep this aligned with postgres.env.
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi_v15
BET_INDEX_READ_ENABLED=true
BET_INDEX_RPC_FALLBACK_ENABLED=false
BET_RECEIPT_RPC_FALLBACK_ENABLED=true
BET_INDEX_SSL=false

# Health checks.
KEEPER_HEALTH_PATH_8453=/var/lib/arbigamefi/casino-keeper/base-mainnet-primary-health.json
KEEPER_HEALTH_PATH_84532=/var/lib/arbigamefi/casino-keeper/base-sepolia-primary-health.json
HEALTHZ_REQUIRE_DURABLE_BET_INDEX=true
HEALTHZ_KEEPER_MAX_AGE_MS=300000

# Sentry / source-map release metadata.
NEXT_PUBLIC_SENTRY_RELEASE=base-mainnet-docker-v1
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Analytics and search verification are optional.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
