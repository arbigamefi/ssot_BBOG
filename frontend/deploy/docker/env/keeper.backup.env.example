# Copy to deploy/docker/env/keeper.backup.env.
# Best practice is a different host/region and a different funded keeper key.

KEEPER_CHAIN_ID=8453
KEEPER_RELEASE_PATH=/app/frontend/packages/ssot/src/release/embedded/chain-8453.json
KEEPER_START_BLOCK=46404343
KEEPER_RPC_HTTP=https://mainnet.base.org
KEEPER_RPC_WS=
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_BACKUP_KEEPER_PRIVATE_KEY

KEEPER_ROLE=backup
KEEPER_BACKUP_DELAY_SECONDS=5
KEEPER_POLL_INTERVAL_SECONDS=5
KEEPER_SCAN_CHUNK_BLOCKS=2000

KEEPER_SPORTS_TERMINALIZER_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_SCAN_CHUNK_BLOCKS=2000
KEEPER_SPORTS_TERMINALIZER_MARKET_IDS=
KEEPER_SPORTS_TERMINALIZER_MAX_TICKETS_PER_MARKET=200
KEEPER_SPORTS_TICKET_ENUMERATION_MAX=500
KEEPER_SPORTS_TICKET_SCAN_CHUNK_BLOCKS=2000
KEEPER_SPORTS_TICKET_SCAN_START_BLOCK=

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi
BET_INDEX_SSL=false
