# Copy to deploy/docker/env/keeper.primary.env.
# Never commit a real keeper private key.

KEEPER_CHAIN_ID=8453
KEEPER_RELEASE_PATH=/app/frontend/packages/ssot/src/release/embedded/chain-8453.json
KEEPER_START_BLOCK=46404343
# Alchemy Free tier limits Base mainnet eth_getLogs to 10 blocks.
KEEPER_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_API_KEY
KEEPER_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_API_KEY
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_PRIMARY_KEEPER_PRIVATE_KEY

KEEPER_ROLE=primary
KEEPER_BACKUP_DELAY_SECONDS=0
KEEPER_POLL_INTERVAL_SECONDS=300
KEEPER_RPC_MIN_INTERVAL_MS=250
# Alchemy's free tier rejects eth_getLogs ranges above 10 blocks; public Base
# endpoints accept ~900. Raise only for a provider with a documented limit.
KEEPER_SCAN_CHUNK_BLOCKS=10
# Bounds one catch-up pass. Unbounded, a cursor months behind becomes one
# provider request per chunk (~750k eth_getLogs for a two-month gap) and
# drains a monthly quota. A chunk is not one request: with index scanning on,
# a gamehub chunk costs five and a bank-ledger chunk two per pool.
# Sustained casino.keeper.scan_capped requires bounded catch-up and gap review.
# Never fast-forward: this cursor also recovers unsettled BetRandomReady events.
KEEPER_SCAN_MAX_CHUNKS_PER_PASS=50
KEEPER_STARTUP_SCAN_ENABLED=false
KEEPER_SCAN_INDEX_EVENTS_ENABLED=false
KEEPER_BANK_PROVIDER_LEDGER_SCAN_INTERVAL_SECONDS=300

# Sports terminalization stays disabled until sportsbook mainnet GO.
KEEPER_SPORTS_TICKET_INDEX_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_SCAN_CHUNK_BLOCKS=10
KEEPER_SPORTS_TERMINALIZER_MARKET_IDS=
KEEPER_SPORTS_TERMINALIZER_MAX_TICKETS_PER_MARKET=200
# Legacy compatibility setting; durable recovery no longer enumerates a tail.
KEEPER_SPORTS_TICKET_ENUMERATION_MAX=500
KEEPER_SPORTS_TICKET_SCAN_CHUNK_BLOCKS=10
# Sports recovery requires BET_INDEX_WRITE_ENABLED and a reachable database.
# This caps blocks per durable ticket-history pass, also bounded by max chunks.
# Progress resumes after restarts; never move the start beyond the deployment
# to skip a backlog. Each completed market drains all ticket pages.
KEEPER_SPORTS_TICKET_SCAN_MAX_BLOCKS=50000
KEEPER_SPORTS_TICKET_SCAN_START_BLOCK=

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi_v15
BET_INDEX_SSL=false
