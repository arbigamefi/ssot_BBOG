# Copy to deploy/docker/env/keeper.primary.env.
# Never commit a real keeper private key.

KEEPER_CHAIN_ID=84532
KEEPER_RELEASE_PATH=/app/frontend/packages/ssot/src/release/embedded/chain-84532.json
# Empty starts at the signed release block.
KEEPER_START_BLOCK=
# HTTP reconciliation uses Infura; event subscriptions use Alchemy.
# Size the RPC limits against the selected plans and measured request traffic.
KEEPER_RPC_HTTP=https://base-sepolia.infura.io/v3/REPLACE_WITH_INFURA_API_KEY
KEEPER_RPC_WS=wss://base-sepolia.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_API_KEY
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_PRIMARY_KEEPER_PRIVATE_KEY

KEEPER_ROLE=primary
KEEPER_BACKUP_DELAY_SECONDS=0
# Normal callbacks settle without a keeper transaction. HTTP replay recovers
# missed WS events and failed callback settlement; this poll interval is not a
# settlement latency guarantee when backlog, RPC failure or retry applies.
KEEPER_POLL_INTERVAL_SECONDS=60
# Serializes this keeper's RPC calls; measure combined primary/backup usage.
KEEPER_RPC_MIN_INTERVAL_MS=1200
# Must fit the selected HTTP provider's current eth_getLogs range limit.
KEEPER_SCAN_CHUNK_BLOCKS=1000
# Bounds one catch-up pass. Unbounded, a cursor months behind becomes one
# provider request per chunk and scanner with no ceiling. GameHub and canonical
# VRF request logs have separate scans; Vault activity includes DepositAdded,
# DepositWithdrawn and ERC721 Transfer events.
# Sustained casino.keeper.scan_capped requires bounded catch-up and gap review.
# Never fast-forward: this cursor also recovers unsettled BetRandomReady events.
KEEPER_SCAN_MAX_CHUNKS_PER_PASS=50
KEEPER_STARTUP_SCAN_ENABLED=false
KEEPER_SCAN_INDEX_EVENTS_ENABLED=true
KEEPER_VAULT_PROVIDER_LEDGER_SCAN_INTERVAL_SECONDS=300
# Gas limit of every voidBet simulation and transaction (ADR-0037 §7). Startup refuses a value
# below VOID_SETTLEMENT_GAS + VOID_RESERVE_GAS + VOID_CALL_OVERHEAD + 150000 (10755000 today)
# or above 16000000; Base caps a transaction at 16,777,216 gas.
KEEPER_VOID_GAS_LIMIT=11000000
# Payables, Vault ledger and governance indexing degrade when the finalized block they read has not
# advanced for this many seconds (0 disables the check).
KEEPER_FINALIZED_STALL_SECONDS=3600

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://arbigamefi:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/arbigamefi
BET_INDEX_SSL=false

# Casino lifecycle recovery defaults to the release block, independently of KEEPER_START_BLOCK.
# Must never be later than the release block. Empty keeps the release origin.
KEEPER_CASINO_RECOVERY_START_BLOCK=
