FROM node:24.15.0-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app/frontend

FROM base AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY patches ./patches
COPY apps/keeper/package.json apps/keeper/package.json
COPY packages/bet-index/package.json packages/bet-index/package.json
COPY packages/ssot/package.json packages/ssot/package.json
RUN --mount=type=cache,id=arbigamefi-pnpm-store,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm install --frozen-lockfile --filter @ssot/keeper...

FROM deps AS builder
COPY apps/keeper apps/keeper
COPY packages/bet-index packages/bet-index
COPY packages/ssot packages/ssot
RUN pnpm -C apps/keeper build

FROM node:24.15.0-slim AS runner
ENV NODE_ENV=production
WORKDIR /app/frontend
RUN corepack enable \
  && groupadd --system --gid 1001 keeper \
  && useradd --system --uid 1001 --gid keeper keeper \
  && mkdir -p /var/lib/arbigamefi/casino-keeper \
  && chown -R keeper:keeper /var/lib/arbigamefi

COPY --from=builder --chown=keeper:keeper /app/frontend/package.json /app/frontend/pnpm-lock.yaml /app/frontend/pnpm-workspace.yaml ./
COPY --from=builder --chown=keeper:keeper /app/frontend/node_modules ./node_modules
COPY --from=builder --chown=keeper:keeper /app/frontend/apps/keeper ./apps/keeper
COPY --from=builder --chown=keeper:keeper /app/frontend/packages/bet-index ./packages/bet-index
COPY --from=builder --chown=keeper:keeper /app/frontend/packages/ssot ./packages/ssot

COPY --from=builder /app/frontend/packages/ssot/src/release/embedded /app/release-manifests

USER keeper
CMD ["node", "apps/keeper/dist/cli.js"]
