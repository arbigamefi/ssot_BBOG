FROM node:24.15.0-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app/frontend

FROM base AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/web/package.json apps/web/package.json
COPY apps/keeper/package.json apps/keeper/package.json
COPY packages/bet-index/package.json packages/bet-index/package.json
COPY packages/ssot/package.json packages/ssot/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,id=arbigamefi-pnpm-store,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm install --frozen-lockfile --filter @ssot/web...

FROM deps AS builder
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG WEB_BUILD_NODE_OPTIONS=--max-old-space-size=1024
ARG WEB_LOW_MEMORY_BUILD=1
ARG NEXT_SKIP_BUILD_VALIDATION=0
ARG NEXT_PUBLIC_SITE_URL=https://arbigamefi.com
ARG NEXT_PUBLIC_ENV=production
ARG NEXT_PUBLIC_CHAIN_ID=8453
ARG NEXT_PUBLIC_WC_PROJECT_ID
ARG NEXT_PUBLIC_ALCHEMY_API_KEY
ARG NEXT_PUBLIC_BASE_RPC_URL
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARG NEXT_PUBLIC_ARBITRUM_RPC_URL
ARG NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL
ARG NEXT_PUBLIC_MAINNET_RPC_URL=https://cloudflare-eth.com
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_ENABLE_ENS_LOOKUP=true
ARG NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=false
ARG NEXT_PUBLIC_SPORTSBOOK_ENABLED=false
ARG NEXT_PUBLIC_SENTRY_RELEASE
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_ANALYTICS_ID
ARG NEXT_PUBLIC_ANALYTICS_HOST
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ARG NEXT_PUBLIC_BING_SITE_VERIFICATION
ENV NODE_OPTIONS=${WEB_BUILD_NODE_OPTIONS}
ENV LOW_MEMORY_BUILD=${WEB_LOW_MEMORY_BUILD}
ENV NEXT_SKIP_BUILD_VALIDATION=${NEXT_SKIP_BUILD_VALIDATION}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_ENV=${NEXT_PUBLIC_ENV}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}
ENV NEXT_PUBLIC_WC_PROJECT_ID=${NEXT_PUBLIC_WC_PROJECT_ID}
ENV NEXT_PUBLIC_ALCHEMY_API_KEY=${NEXT_PUBLIC_ALCHEMY_API_KEY}
ENV NEXT_PUBLIC_BASE_RPC_URL=${NEXT_PUBLIC_BASE_RPC_URL}
ENV NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=${NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL}
ENV NEXT_PUBLIC_ARBITRUM_RPC_URL=${NEXT_PUBLIC_ARBITRUM_RPC_URL}
ENV NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=${NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL}
ENV NEXT_PUBLIC_MAINNET_RPC_URL=${NEXT_PUBLIC_MAINNET_RPC_URL}
ENV NEXT_PUBLIC_RPC_URL=${NEXT_PUBLIC_RPC_URL}
ENV NEXT_PUBLIC_ENABLE_ENS_LOOKUP=${NEXT_PUBLIC_ENABLE_ENS_LOOKUP}
ENV NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=${NEXT_PUBLIC_CASINO_RISK_IN_ENABLED}
ENV NEXT_PUBLIC_SPORTSBOOK_ENABLED=${NEXT_PUBLIC_SPORTSBOOK_ENABLED}
ENV NEXT_PUBLIC_SENTRY_RELEASE=${NEXT_PUBLIC_SENTRY_RELEASE}
ENV NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}
ENV NEXT_PUBLIC_ANALYTICS_ID=${NEXT_PUBLIC_ANALYTICS_ID}
ENV NEXT_PUBLIC_ANALYTICS_HOST=${NEXT_PUBLIC_ANALYTICS_HOST}
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=${NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION}
ENV NEXT_PUBLIC_BING_SITE_VERIFICATION=${NEXT_PUBLIC_BING_SITE_VERIFICATION}
RUN pnpm -C apps/web build

FROM node:24.15.0-slim AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/frontend/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/apps/web/public ./apps/web/public

COPY --from=builder /app/frontend/packages/ssot/src/release/embedded /app/release-manifests

USER nextjs
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["node", "server.js"]
