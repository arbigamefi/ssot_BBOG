# Copy to /etc/arbigamefi/casino-keeper/backup.env on the backup host.
# Never commit the real file. Use a different keeper EOA and RPC provider
# from the primary instance.

KEEPER_CHAIN_ID=84532
KEEPER_RELEASE_PATH=/opt/arbigamefi_ssot_project_all/frontend/packages/ssot/src/release/embedded/chain-84532.json
KEEPER_START_BLOCK=42600719
KEEPER_RPC_HTTP=https://base-sepolia-backup.example
KEEPER_RPC_WS=wss://base-sepolia-backup.example
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_BACKUP_KEEPER_PRIVATE_KEY

KEEPER_ROLE=backup
KEEPER_BACKUP_DELAY_SECONDS=5
KEEPER_POLL_INTERVAL_SECONDS=60
KEEPER_SCAN_CHUNK_BLOCKS=10
KEEPER_BANK_PROVIDER_LEDGER_SCAN_INTERVAL_SECONDS=60
KEEPER_HEALTH_PATH=/var/lib/arbigamefi/casino-keeper/backup-health.json

KEEPER_SPORTS_TICKET_INDEX_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_ENABLED=false
KEEPER_SPORTS_TERMINALIZER_SCAN_CHUNK_BLOCKS=2000
KEEPER_SPORTS_TERMINALIZER_MARKET_IDS=
KEEPER_SPORTS_TERMINALIZER_MAX_TICKETS_PER_MARKET=200
KEEPER_SPORTS_TICKET_ENUMERATION_MAX=500
KEEPER_SPORTS_TICKET_SCAN_CHUNK_BLOCKS=2000
KEEPER_SPORTS_TICKET_SCAN_START_BLOCK=

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://user:password@postgres.example:5432/arbigamefi
BET_INDEX_SSL=true
