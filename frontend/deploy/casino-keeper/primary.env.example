# Local development template; production uses deploy/docker.
# Never commit the real file.

KEEPER_CHAIN_ID=84532
KEEPER_RELEASE_PATH=/opt/arbigamefi_ssot_project_all/frontend/packages/ssot/src/release/embedded/chain-84532.json
# Default to the newly deployed release block.
KEEPER_START_BLOCK=
KEEPER_RPC_HTTP=https://base-sepolia.example
KEEPER_RPC_WS=wss://base-sepolia.example
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_PRIMARY_KEEPER_PRIVATE_KEY

KEEPER_ROLE=primary
KEEPER_BACKUP_DELAY_SECONDS=0
KEEPER_POLL_INTERVAL_SECONDS=60
KEEPER_SCAN_CHUNK_BLOCKS=2000
KEEPER_VAULT_PROVIDER_LEDGER_SCAN_INTERVAL_SECONDS=60
KEEPER_HEALTH_PATH=/var/lib/arbigamefi/casino-keeper/primary-health.json
KEEPER_STATE_DIR=/var/lib/arbigamefi/casino-keeper/primary-state
# Gas limit of every voidBet simulation and transaction (ADR-0037 §7). Startup refuses a value
# below VOID_SETTLEMENT_GAS + VOID_RESERVE_GAS + VOID_CALL_OVERHEAD + 150000 (10755000 today)
# or above 16000000; Base caps a transaction at 16,777,216 gas.
KEEPER_VOID_GAS_LIMIT=11000000
# Payables, Vault ledger and governance indexing degrade when the finalized block they read has not
# advanced for this many seconds (0 disables the check).
KEEPER_FINALIZED_STALL_SECONDS=3600

BET_INDEX_WRITE_ENABLED=true
BET_INDEX_DATABASE_URL=postgres://user:password@postgres.example:5432/arbigamefi
BET_INDEX_SSL=true

# Casino lifecycle recovery defaults to the release block, independently of KEEPER_START_BLOCK.
# Must never be later than the release block. Empty keeps the release origin.
KEEPER_CASINO_RECOVERY_START_BLOCK=
