{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ssot/ui": ["packages/ui/src"],
      "@ssot/ui/*": ["packages/ui/src/*"],
      "@ssot/ssot": ["packages/ssot/src"],
      "@ssot/ssot/*": ["packages/ssot/src/*"]
    }
  }
}
