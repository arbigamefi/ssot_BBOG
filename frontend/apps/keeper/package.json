{
  "name": "@ssot/keeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "backfill": "node dist/backfill.js",
    "prebackfill": "pnpm -C ../../packages/bet-index build && tsc -p tsconfig.json",
    "prebuild": "pnpm -C ../../packages/bet-index build",
    "build": "tsc -p tsconfig.json",
    "prestart": "pnpm -C ../../packages/bet-index build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts"
  },
  "dependencies": {
    "@ssot/bet-index": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
