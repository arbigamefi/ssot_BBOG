# ──────────────────────────────────────────────
# SSOT Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser bundle. Never put secrets here.
# ──────────────────────────────────────────────

# WalletConnect Cloud project ID (optional)
# Get one free at https://cloud.walletconnect.com
# Falls back to demo ID if not set.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public browser RPC. Prefer a chain-specific URL. If only
# NEXT_PUBLIC_ALCHEMY_API_KEY is set, Base/Arbitrum RPC URLs are derived from it.
# Do not put private RPC credentials here unless they are intended for browsers.
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_BASE_RPC_URL=
# NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_ARBITRUM_RPC_URL=
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_ALCHEMY_API_KEY=

# Sportsbook frontend entrypoints must stay disabled until the approved
# sportsbook.frontend-access.v1 memo passes REQUIRE_APPROVED=1.
NEXT_PUBLIC_SPORTSBOOK_ENABLED=false

# Server-only sportsbook odds signing route.
# These values are read by /api/sportsbook/odds-snapshot and must never use
# NEXT_PUBLIC_ prefixes.
# THE_ODDS_API_KEY=
# SPORTS_PROVIDER_SPORT_KEY=soccer_fifa_world_cup
# SPORTS_PROVIDER_EVENT_ID=
# SPORTS_BOOKMAKER_KEY=
# THE_ODDS_API_REGIONS=us,uk,eu,au
# SPORTS_ODDS_TTL_SECONDS=120
# SPORTS_ODDS_SIGNER_PRIVATE_KEY=
# SPORTS_ODDS_SIGNER=
# RPC_URL=

# Sentry error tracking (optional)
# Leave blank to disable error tracking.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for source map upload (CI only, not NEXT_PUBLIC_)
# SENTRY_AUTH_TOKEN=

# Analytics — Plausible-compatible (optional)
# Set domain/site ID to enable page view + event tracking.
# Leave blank to disable (events logged to console in dev only).
NEXT_PUBLIC_ANALYTICS_ID=
# Custom analytics host (defaults to https://plausible.io)
# Use this for self-hosted Plausible or PostHog instances.
# NEXT_PUBLIC_ANALYTICS_HOST=https://plausible.io
