# ──────────────────────────────────────────────
# SSOT Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser bundle. Never put secrets here.
# ──────────────────────────────────────────────

# WalletConnect Cloud project ID (optional)
# Get one free at https://cloud.walletconnect.com
# Falls back to demo ID if not set.
NEXT_PUBLIC_WC_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Public browser RPC.
#
# NEXT_PUBLIC_CHAIN_ID is ONLY the default selected release; users switch among
# embedded release chains at runtime. Each active chain needs its OWN endpoint.
#
# Resolution order per chain: chain-specific URL → Alchemy key (per-network)
# → generic URL (single-chain deployments only).
#
# RECOMMENDED for multi-chain: set ONLY NEXT_PUBLIC_ALCHEMY_API_KEY. It derives
# the correct per-network endpoint for every chain (base-mainnet, base-sepolia,
# arb-mainnet, …) from one value.
#   NEXT_PUBLIC_ALCHEMY_API_KEY=your-key
# Or set each chain-specific URL explicitly:
#   NEXT_PUBLIC_BASE_RPC_URL / NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL / etc.
# Browser round tracking can use WSS event wakeups. Alchemy HTTP URLs can derive
# WSS automatically, or set each chain-specific WSS URL explicitly.
#
# NEXT_PUBLIC_RPC_URL is a SINGLE shared URL — it points to ONE network, so it
# is IGNORED when more than one chain is embedded. Use it only for a true
# single-chain deployment. Do not put private RPC credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_BASE_WS_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_WS_RPC_URL=
NEXT_PUBLIC_ARBITRUM_WS_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_WS_RPC_URL=
NEXT_PUBLIC_MAINNET_WS_RPC_URL=
NEXT_PUBLIC_RPC_URL=
# Optional identity chrome. Disabled by default so the app does not add
# Ethereum mainnet RPC calls just to render the connected wallet label.
# If enabled, set NEXT_PUBLIC_MAINNET_RPC_URL to a stable Ethereum mainnet RPC.
NEXT_PUBLIC_ENABLE_ENS_LOOKUP=false
BASE_MAINNET_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Casino Base mainnet risk-in must stay disabled until the approved
# casino.frontend-access.v1 memo passes REQUIRE_APPROVED=1.
# Base Sepolia and local development are not gated by this flag.
NEXT_PUBLIC_CASINO_RISK_IN_ENABLED=false
# LP deposits on any mainnet have their own switch, so opening bets does not
# reopen deposits. Keep this false until current release acceptance is complete.
# until the pool terms change. Testnets and withdrawals are not gated by it.
NEXT_PUBLIC_LP_DEPOSITS_ENABLED=false

# Public indexed read API limits.
# BETS_RECENT_RATE_LIMIT_PER_MINUTE=120
# BETS_PLAYER_RATE_LIMIT_PER_MINUTE=120
# BETS_AFFILIATE_RATE_LIMIT_PER_MINUTE=120
# HEALTHZ_RATE_LIMIT_PER_MINUTE=120

# Server-only durable bet-index reads. Required for Base mainnet health checks,
# recent bets, casino analytics, player history, bankroll provider ledgers and
# the scheduled governance changes on Earn and Ops (the keeper indexes the
# governance timelock into the same database).
# Do not prefix with NEXT_PUBLIC_.
# Local Docker Postgres:
# BET_INDEX_DATABASE_URL=postgres://arbigamefi:arbigamefi_dev_only@127.0.0.1:54329/arbigamefi
BET_INDEX_DATABASE_URL=
BET_INDEX_READ_ENABLED=true
BET_INDEX_RPC_FALLBACK_ENABLED=false
BET_RECEIPT_RPC_FALLBACK_ENABLED=true
BET_INDEX_SSL=false

# Canonical site origin — drives metadataBase, canonical URLs, sitemap,
# robots, and Open Graph image URLs. Set per environment. Only the production
# mainnet origin should be indexable; testnet/preview/localhost auto-noindex.
NEXT_PUBLIC_SITE_URL=https://arbigamefi.com

# Search-engine site verification tokens (optional). Paste the value from
# Google Search Console / Bing Webmaster Tools to emit the verification meta.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Sentry error tracking (optional)
# Leave blank to disable error tracking.
# NEXT_PUBLIC_ENV must be "production" (with a non-testnet NEXT_PUBLIC_SITE_URL)
# for the site to be crawlable; any other value keeps it noindex.
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=

# Local development convenience only. These flags are ignored in production
# builds even if set to "true".
NEXT_PUBLIC_DEV_DISABLE_AGE_GATE=false
NEXT_PUBLIC_DEV_DISABLE_ONBOARDING=false

# Sentry auth token for source map upload (CI only, not NEXT_PUBLIC_)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Analytics — Plausible-compatible (optional)
# Set domain/site ID to enable page view + event tracking.
# Leave blank to disable (events logged to console in dev only).
NEXT_PUBLIC_ANALYTICS_ID=
# Custom analytics host (defaults to https://plausible.io)
# Use this for self-hosted Plausible or PostHog instances.
# NEXT_PUBLIC_ANALYTICS_HOST=https://plausible.io
